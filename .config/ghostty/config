custom-shader = ./shaders/cursors/cursor_warp.glsl

theme = "catppuccin-macchiato"

font-size = 14
font-family = "ZedMono NFM Extd Bold"

background-opacity = 0.9
background-blur-radius = 20

window-padding-x = 10
window-padding-y = 10

# if on macosx:
window-vsync = true

macos-titlebar-proxy-icon=hidden
macos-icon = custom
macos-custom-icon = ~/.config/ghostty/icons/catppuccin-macchiato.icns
